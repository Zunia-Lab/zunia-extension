{
  "name": "zunia-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Zunia browser extension for Cosmos multi-chain wallet (Chrome, Firefox, Edge, Safari)",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "dev:safari": "wxt -b safari",
    "build": "npm run build:chrome && npm run build:firefox && npm run build:edge && npm run build:safari",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:safari": "wxt build -b safari",
    "zip": "npm run zip:chrome && npm run zip:firefox && npm run zip:edge",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:safari": "wxt zip -b safari",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wxt": "^0.20.0"
  }
}
