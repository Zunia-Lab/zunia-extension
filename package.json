{
  "name": "zunia-extension",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "description": "Zunia browser extension for Cosmos multi-chain wallet (Chrome, Firefox, Edge, Safari)",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "dev:safari": "wxt -b safari",
    "build": "pnpm run build:chrome && pnpm run build:firefox && pnpm run build:edge && pnpm run build:safari",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:safari": "wxt build -b safari",
    "zip": "pnpm run zip:chrome && pnpm run zip:firefox && pnpm run zip:edge",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:safari": "wxt zip -b safari",
    "chains:generate": "node scripts/generate-chain-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@zunialab/fonts": "^0.1.0",
    "@zunialab/tokens": "^0.1.0",
    "@zunialab/ui": "^0.1.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "wxt": "^0.21.4"
  },
  "pnpm": {
    "//": "BOOTSTRAP: resolves the @zunialab/* semver ranges above to local paths until the npm scope is live. Delete this whole pnpm block once published. See zunia-ui/RELEASING.md.",
    "overrides": {
      "@zunialab/ui": "link:../zunia-ui/packages/ui",
      "@zunialab/tokens": "link:../zunia-ui/packages/tokens",
      "@zunialab/fonts": "link:../zunia-ui/packages/fonts"
    }
  }
}
